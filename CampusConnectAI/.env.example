# CampusConnectAI (IVY) environment variables.
# Copy this file to `.env` and fill in your own values. Never commit the real
# `.env` — it is gitignored on purpose because it holds live secrets.

# --- Core (required) -------------------------------------------------------
# Flask signs session cookies with this key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# Supabase project (Settings → API).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-publishable-or-anon-key
# PostgreSQL connection string (Settings → Database → Connection string → URI).
SUPABASE_DB_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# --- AI assistant ----------------------------------------------------------
# Required for the IVY assistant. Optional overrides choose the chat and
# vision models (defaults: openai/gpt-oss-120b and built-in Llama 4 vision).
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Video learning rooms (WebRTC) -----------------------------------------
# Comma-separated. A TURN relay is required for calls across restrictive NATs.
STUN_SERVER=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER=turn:your-turn-host:443?transport=tcp
TURN_USERNAME=your-turn-username
TURN_PASSWORD=your-turn-password

# --- Google Sign-In (optional) ---------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Email delivery (optional) ---------------------------------------------
# Preferred: Brevo Transactional Email API key (starts with xkeysib-).
# Without it the app falls back to the SMTP relay values below, and prints
# messages to the console when neither is configured.
BREVO_API_KEY=xkeysib-your-brevo-api-key
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=IVY <noreply@example.com>

# --- Local/deployment flags (optional) -------------------------------------
# PORT=5001
# IVY_DEBUG=1
# SESSION_COOKIE_SECURE=true
